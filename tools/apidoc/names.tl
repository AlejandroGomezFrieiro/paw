-- The names that the readers and writers of tools/apidoc.lua give and avoid.
local record names
  --- Lua's keywords, which cannot name a parameter or a field in Teal either.
  KEYWORDS: {string: boolean}
  --- What each file that tools/apidoc.lua makes says first.
  HEADER: string
  --- The kernel's event descriptors: write/kernel_events.tl makes the file,
  --- and read/teal.tl reads the payload of an event of the runtime that is
  --- a `kernel.X` record from it.
  EVENTS_TL: string
end

names.EVENTS_TL = "runtime/lua/paw/events/kernel.tl"
names.HEADER = "Generated by tools/apidoc.lua from the source's comments: do not edit."

names.KEYWORDS = {}
for word in (
  "and break do else elseif end false for function goto if in local nil not or repeat return then true until while"
):gmatch("%a+") do
  names.KEYWORDS[word] = true
end

--- A record's name for a module: `paw.part_kinds` is `PartKinds`.
function names.record(name: string): string
  return (name:gsub("^paw%.", ""):gsub("[._](%l)", string.upper):gsub("^%l", string.upper))
end

--- The alias that paw.d.tl gives the type of a module in Teal:
--- `paw.harmony.read` is `HarmonyReadModule`.
function names.alias(name: string): string
  return names.record(name) .. "Module"
end

return names
