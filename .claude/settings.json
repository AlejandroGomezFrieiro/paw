{
  "env": {
    "PAW_SUITE_LOCKS": "/tmp/paw-suite-locks"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git push",
      "git push *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cargo",
        "~/.cache/sccache",
        "~/.cache/nix",
        "/tmp/paw-suite-locks"
      ],
      "denyRead": [
        "~/.config/paw",
        "~/.local/share/OpenUtau",
        "~/.config/REAPER",
        "~/.wine",
        "~/.local/share/wineprefixes",
        "~/.ssh",
        "~/.gnupg"
      ],
      "denyWrite": [
        "~/.config/paw",
        "~/.local/share/OpenUtau",
        "~/.config/REAPER",
        "~/.wine",
        "~/.local/share/wineprefixes",
        "~/.ssh",
        "~/.gnupg"
      ]
    },
    "network": {
      "allowedDomains": [
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "cache.nixos.org",
        "channels.nixos.org",
        "docs.rs",
        "doc.rust-lang.org"
      ],
      "allowAllUnixSockets": true
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/vale-hook.sh",
            "timeout": 120,
            "statusMessage": "Vale: checking the Markdown"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/guard-hook.py",
            "timeout": 10,
            "statusMessage": "Checking the command against the rules of AGENTS.md"
          }
        ]
      }
    ]
  }
}
