#!/bin/sh
# The fast checks before each commit, in each worktree of the repository.
# Turn it on once for the checkout: git config core.hooksPath .githooks
# The full checks stay in the tiers of the skill paw-code (part 7).
cd "$(git rev-parse --show-toplevel)" || exit 1
tools/hygiene.sh > /dev/null || exec tools/hygiene.sh
tools/reformat-check.sh || exit 1
if command -v luajit > /dev/null; then
  for lint in partlint testlint layers zoomlint; do
    out=$(luajit "tools/$lint.lua" 2>&1) || {
      echo "$out"
      exit 1
    }
  done
else
  echo "pre-commit: no luajit outside the dev shell; partlint, testlint, layers and zoomlint did not run" >&2
fi
if [ -x tools/rustlint.sh ]; then
  tools/rustlint.sh > /dev/null || exec tools/rustlint.sh
fi
