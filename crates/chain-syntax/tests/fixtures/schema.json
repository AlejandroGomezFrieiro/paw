{
  "chain_schema": 1,
  "host": "example",
  "devices": [
    {
      "kind": "eq",
      "name": "EQ",
      "params": [
        { "key": "hp", "type": "number", "unit": "Hz", "min": 10, "max": 20000, "default": 10 },
        { "key": "lp", "type": "number", "unit": "Hz", "min": 10, "max": 20000, "default": 20000 },
        { "key": "b1.freq", "type": "number", "unit": "Hz", "min": 10, "max": 20000, "default": 1000 },
        { "key": "b1.gain", "type": "number", "unit": "dB", "min": -24, "max": 24, "default": 0 }
      ]
    },
    {
      "kind": "compressor",
      "name": "Compressor",
      "params": [
        { "key": "threshold", "type": "number", "unit": "dB", "min": -60, "max": 0, "default": -18 },
        { "key": "ratio", "type": "number", "label": ":1", "min": 1, "max": 20, "default": 4 },
        { "key": "attack", "type": "number", "unit": "ms", "min": 0.1, "max": 100, "default": 10 },
        { "key": "release", "type": "number", "unit": "ms", "min": 10, "max": 1000, "default": 120 },
        { "key": "makeup", "type": "number", "unit": "dB", "min": 0, "max": 24, "default": 0 },
        { "key": "key", "type": "source" }
      ]
    },
    {
      "kind": "saturation",
      "name": "Saturation",
      "params": [
        { "key": "drive", "type": "number", "unit": "dB", "min": 0, "max": 36, "default": 6 },
        { "key": "curve", "type": "choice", "choices": ["soft", "tube", "tape"], "default": "soft" },
        { "key": "mix", "type": "number", "unit": "%", "min": 0, "max": 100, "default": 100 }
      ]
    },
    {
      "kind": "gate",
      "name": "Gate",
      "params": [
        { "key": "threshold", "type": "number", "unit": "dB", "min": -80, "max": 0, "default": -40 },
        { "key": "key", "type": "source" }
      ]
    },
    {
      "kind": "delay",
      "name": "Delay",
      "params": [
        { "key": "time", "type": "note", "default": "1/4" },
        { "key": "feedback", "type": "number", "unit": "%", "min": 0, "max": 100, "default": 30 },
        { "key": "pingpong", "type": "switch", "default": false }
      ]
    },
    {
      "kind": "limiter",
      "name": "Limiter",
      "params": [
        { "key": "ceiling", "type": "number", "unit": "dB", "min": -24, "max": 0, "default": -1 }
      ]
    },
    { "kind": "sampler", "name": "Sampler", "open_params": true }
  ],
  "splits": [
    {
      "kind": "rack",
      "name": "Rack",
      "branches": { "min": 1, "max": 1 },
      "params": [
        { "key": "mix", "type": "number", "unit": "%", "min": 0, "max": 100, "default": 100 }
      ]
    },
    {
      "kind": "layer",
      "name": "Layer",
      "branches": { "min": 1, "max": 16 },
      "params": [
        { "key": "mix", "type": "number", "unit": "%", "min": 0, "max": 100, "default": 100 }
      ],
      "branch_params": [
        { "key": "gain", "type": "number", "unit": "dB", "min": -60, "max": 12, "default": 0 },
        { "key": "pan", "type": "number", "min": -1, "max": 1, "default": 0 },
        { "key": "mute", "type": "switch", "default": false }
      ]
    },
    {
      "kind": "band",
      "name": "Band split",
      "branches": { "min": 2, "max": 6 },
      "params": [
        { "key": "xover", "type": "list", "unit": "Hz", "min": 20, "max": 20000, "count": { "min": 1, "max": 5 }, "ascending": true }
      ],
      "branch_params": [
        { "key": "gain", "type": "number", "unit": "dB", "min": -60, "max": 12, "default": 0 }
      ]
    }
  ],
  "modulators": [
    {
      "kind": "macro",
      "name": "Macro",
      "params": [
        { "key": "value", "type": "number", "unit": "%", "min": 0, "max": 100, "default": 0 }
      ]
    },
    {
      "kind": "lfo",
      "name": "LFO",
      "params": [
        { "key": "rate", "type": "number", "unit": "Hz", "min": 0.01, "max": 50, "default": 1 },
        { "key": "sync", "type": "note" },
        { "key": "shape", "type": "choice", "choices": ["sine", "triangle", "square"], "default": "sine" }
      ]
    }
  ],
  "open_prefixes": ["clap:"]
}
