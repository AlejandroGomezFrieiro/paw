{
  "chain_schema": 3,
  "host": "example",
  "streams": [
    {
      "stream": "audio",
      "name": "Audio",
      "time": "samples",
      "records": true,
      "props": [{ "key": "channels", "type": "integer", "minimum": 1, "maximum": 64, "default": 2 }]
    },
    {
      "stream": "midi",
      "name": "MIDI",
      "time": "beats",
      "records": true,
      "props": [{ "key": "lyrics", "type": "boolean", "default": false }]
    },
    { "stream": "curve", "name": "Curve", "time": "beats", "records": true, "control": true },
    { "stream": "keyframes", "name": "Keyframes", "time": "beats" },
    { "stream": "video", "name": "Video", "time": "seconds", "records": true }
  ],
  "default_ports": [
    { "port": "in", "stream": "audio", "main": true },
    { "port": "out", "stream": "audio", "main": true, "out": true }
  ],
  "nodes": [
    {
      "kind": "strip",
      "name": "Strip",
      "params": [
        { "key": "gain", "type": "number", "unit": "dB", "minimum": -60, "maximum": 12, "default": 0 },
        { "key": "pan", "type": "number", "minimum": -1, "maximum": 1, "default": 0 },
        { "key": "mute", "type": "boolean", "default": false },
        { "key": "solo", "type": "boolean", "default": false }
      ],
      "ports": [
        { "port": "in", "stream": "audio", "main": true },
        { "port": "notes", "stream": "midi", "main": true },
        { "port": "out", "stream": "audio", "main": true, "out": true }
      ]
    },
    {
      "kind": "bus",
      "name": "Bus",
      "params": [
        { "key": "gain", "type": "number", "unit": "dB", "minimum": -60, "maximum": 12, "default": 0 },
        { "key": "pan", "type": "number", "minimum": -1, "maximum": 1, "default": 0 }
      ]
    },
    {
      "kind": "master",
      "name": "Master",
      "params": [{ "key": "gain", "type": "number", "unit": "dB", "minimum": -60, "maximum": 12, "default": 0 }]
    },
    {
      "kind": "send",
      "name": "Send",
      "params": [
        { "key": "level", "type": "number", "unit": "dB", "minimum": -60, "maximum": 12, "default": 0 },
        { "key": "pre", "type": "boolean", "default": false }
      ]
    },
    {
      "kind": "vca",
      "name": "VCA",
      "params": [{ "key": "gain", "type": "number", "unit": "dB", "minimum": -60, "maximum": 12, "default": 0 }],
      "ports": [{ "port": "gain", "stream": "curve", "main": true, "out": true }]
    }
  ],
  "devices": [
    {
      "kind": "synth",
      "name": "Synth",
      "params": [{ "key": "voices", "type": "integer", "minimum": 1, "maximum": 32, "default": 8 }],
      "ports": [
        { "port": "notes", "stream": "midi", "main": true },
        { "port": "out", "stream": "audio", "main": true, "out": true }
      ]
    },
    {
      "kind": "arp",
      "name": "Arpeggiator",
      "params": [{ "key": "rate", "type": "string", "format": "note" }],
      "ports": [
        { "port": "notes", "stream": "midi", "main": true },
        { "port": "out", "stream": "midi", "main": true, "out": true }
      ]
    },
    {
      "kind": "eq",
      "name": "EQ",
      "params": [
        { "key": "hp", "type": "number", "unit": "Hz", "minimum": 10, "maximum": 20000, "default": 10 },
        { "key": "lp", "type": "number", "unit": "Hz", "minimum": 10, "maximum": 20000, "default": 20000 },
        { "key": "b1.freq", "type": "number", "unit": "Hz", "minimum": 10, "maximum": 20000, "default": 1000 },
        { "key": "b1.gain", "type": "number", "unit": "dB", "minimum": -24, "maximum": 24, "default": 0 }
      ]
    },
    {
      "kind": "compressor",
      "name": "Compressor",
      "params": [
        { "key": "threshold", "type": "number", "unit": "dB", "minimum": -60, "maximum": 0, "default": -18 },
        { "key": "ratio", "label": ":1", "type": "number", "minimum": 1, "maximum": 20, "default": 4 },
        { "key": "attack", "type": "number", "unit": "ms", "minimum": 0.1, "maximum": 100, "default": 10 },
        { "key": "release", "type": "number", "unit": "ms", "minimum": 10, "maximum": 1000, "default": 120 },
        { "key": "makeup", "type": "number", "unit": "dB", "minimum": 0, "maximum": 24, "default": 0 },
        { "key": "key", "type": "source", "stream": "audio" }
      ]
    },
    {
      "kind": "saturation",
      "name": "Saturation",
      "params": [
        { "key": "drive", "type": "number", "unit": "dB", "minimum": 0, "maximum": 36, "default": 6 },
        { "key": "curve", "type": "string", "enum": ["soft", "tube", "tape"], "default": "soft" },
        { "key": "mix", "type": "number", "unit": "%", "minimum": 0, "maximum": 100, "default": 100 }
      ]
    },
    {
      "kind": "gate",
      "name": "Gate",
      "params": [
        { "key": "threshold", "type": "number", "unit": "dB", "minimum": -80, "maximum": 0, "default": -40 },
        { "key": "key", "type": "source" }
      ]
    },
    {
      "kind": "delay",
      "name": "Delay",
      "params": [
        { "key": "time", "type": "string", "format": "note", "default": "1/4" },
        { "key": "feedback", "type": "number", "unit": "%", "minimum": 0, "maximum": 100, "default": 30 },
        { "key": "pingpong", "type": "boolean", "default": false }
      ]
    },
    {
      "kind": "limiter",
      "name": "Limiter",
      "params": [
        { "key": "ceiling", "type": "number", "unit": "dB", "minimum": -24, "maximum": 0, "default": -1 }
      ]
    },
    { "kind": "sampler", "name": "Sampler", "open_params": true }
  ],
  "splits": [
    {
      "kind": "rack",
      "name": "Rack",
      "branches": { "min": 1, "max": 1 },
      "params": [
        { "key": "mix", "type": "number", "unit": "%", "minimum": 0, "maximum": 100, "default": 100 }
      ]
    },
    {
      "kind": "layer",
      "name": "Layer",
      "branches": { "min": 1, "max": 16 },
      "params": [
        { "key": "mix", "type": "number", "unit": "%", "minimum": 0, "maximum": 100, "default": 100 }
      ],
      "branch_params": [
        { "key": "gain", "type": "number", "unit": "dB", "minimum": -60, "maximum": 12, "default": 0 },
        { "key": "pan", "type": "number", "minimum": -1, "maximum": 1, "default": 0 },
        { "key": "mute", "type": "boolean", "default": false }
      ]
    },
    {
      "kind": "band",
      "name": "Band split",
      "branches": { "min": 2, "max": 6 },
      "params": [
        { "key": "xover", "type": "array", "items": { "type": "number", "unit": "Hz", "minimum": 20, "maximum": 20000 }, "minItems": 1, "maxItems": 5, "ascending": true }
      ],
      "branch_params": [
        { "key": "gain", "type": "number", "unit": "dB", "minimum": -60, "maximum": 12, "default": 0 }
      ]
    }
  ],
  "modulators": [
    {
      "kind": "macro",
      "name": "Macro",
      "params": [
        { "key": "value", "type": "number", "unit": "%", "minimum": 0, "maximum": 100, "default": 0 }
      ]
    },
    {
      "kind": "lfo",
      "name": "LFO",
      "params": [
        { "key": "rate", "type": "number", "unit": "Hz", "minimum": 0.01, "maximum": 50, "default": 1 },
        { "key": "sync", "type": "string", "format": "note" },
        { "key": "shape", "type": "string", "enum": ["sine", "triangle", "square"], "default": "sine" }
      ]
    }
  ],
  "producers": [
    {
      "kind": "render",
      "name": "Render",
      "tier": "bake",
      "ports": [
        { "port": "in", "stream": "audio", "main": true },
        { "port": "out", "stream": "audio", "main": true, "out": true }
      ]
    },
    {
      "kind": "midi-keys",
      "name": "Keyframes from MIDI",
      "tier": "kernel",
      "params": [{ "key": "smooth", "type": "number", "unit": "ms", "minimum": 0, "maximum": 1000, "default": 0 }],
      "ports": [
        { "port": "notes", "stream": "midi", "main": true },
        { "port": "keys", "stream": "keyframes", "main": true, "out": true }
      ]
    },
    {
      "kind": "singer",
      "name": "Singer",
      "tier": "bake",
      "params": [{ "key": "voice", "type": "string" }],
      "ports": [
        { "port": "notes", "stream": "midi", "props": { "lyrics": true }, "main": true },
        { "port": "out", "stream": "audio", "props": { "channels": 1 }, "main": true, "out": true }
      ]
    },
    {
      "kind": "pitch",
      "name": "Pitch to MIDI",
      "tier": "bake",
      "ports": [
        { "port": "in", "stream": "audio", "props": { "channels": 1 }, "main": true },
        { "port": "notes", "stream": "midi", "main": true, "out": true }
      ]
    },
    {
      "kind": "avatar",
      "name": "Avatar",
      "tier": "bake",
      "params": [
        { "key": "camera", "type": "source", "stream": "video" },
        { "key": "script", "type": "string" }
      ],
      "ports": [
        { "port": "keys", "stream": "keyframes", "main": true },
        { "port": "notes", "stream": "midi" },
        { "port": "video", "stream": "video", "main": true, "out": true }
      ]
    },
    {
      "kind": "mono",
      "name": "To mono",
      "converts": true,
      "ports": [
        { "port": "in", "stream": "audio", "props": { "channels": 2 }, "main": true },
        { "port": "out", "stream": "audio", "props": { "channels": 1 }, "main": true, "out": true }
      ]
    },
    {
      "kind": "stereo",
      "name": "To stereo",
      "converts": true,
      "ports": [
        { "port": "in", "stream": "audio", "props": { "channels": 1 }, "main": true },
        { "port": "out", "stream": "audio", "props": { "channels": 2 }, "main": true, "out": true }
      ]
    }
  ],
  "io": [
    {
      "kind": "audio-in",
      "name": "Audio input",
      "params": [{ "key": "channel", "type": "integer", "minimum": 1, "maximum": 64, "default": 1 }],
      "ports": [{ "port": "out", "stream": "audio", "props": { "channels": 1 }, "main": true, "out": true }]
    },
    {
      "kind": "midi-in",
      "name": "MIDI input",
      "params": [{ "key": "device", "type": "string" }],
      "ports": [{ "port": "out", "stream": "midi", "main": true, "out": true }]
    }
  ],
  "open_prefixes": ["clap:"]
}
