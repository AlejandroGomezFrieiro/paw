{
  "chain_schema": 3,
  "host": "example",
  "streams": [{ "stream": "audio", "name": "Audio" }, { "stream": "midi", "name": "MIDI" }],
  "nodes": [
    {
      "kind": "strip",
      "ports": [
        { "port": "in", "stream": "audio", "main": true },
        { "port": "notes", "stream": "midi", "main": true },
        { "port": "out", "stream": "audio", "main": true, "out": true }
      ]
    }
  ],
  "devices": [
    {
      "kind": "compressor",
      "name": "Compressor",
      "params": [
        { "key": "threshold", "type": "number", "unit": "dB", "minimum": -60, "maximum": 0, "default": -18 },
        { "key": "ratio", "type": "number", "minimum": 1, "maximum": 20, "default": 4 },
        { "key": "key", "type": "source" }
      ]
    },
    {
      "kind": "saturation",
      "name": "Saturation",
      "params": [
        { "key": "drive", "type": "number", "unit": "dB", "minimum": 0, "maximum": 36, "default": 6 },
        { "key": "curve", "type": "string", "enum": ["soft", "tube", "tape"], "default": "soft" }
      ]
    }
  ],
  "splits": [
    { "kind": "rack", "name": "Rack", "branches": { "min": 1, "max": 1 } }
  ],
  "modulators": [
    { "kind": "macro", "name": "Macro", "params": [] }
  ]
}
