{
  "chain_schema": 1,
  "host": "example",
  "devices": [
    {
      "kind": "compressor",
      "name": "Compressor",
      "params": [
        { "key": "threshold", "type": "number", "unit": "dB", "min": -60, "max": 0, "default": -18 },
        { "key": "ratio", "type": "number", "min": 1, "max": 20, "default": 4 },
        { "key": "key", "type": "source" }
      ]
    },
    {
      "kind": "saturation",
      "name": "Saturation",
      "params": [
        { "key": "drive", "type": "number", "unit": "dB", "min": 0, "max": 36, "default": 6 },
        { "key": "curve", "type": "choice", "choices": ["soft", "tube", "tape"], "default": "soft" }
      ]
    }
  ],
  "splits": [
    { "kind": "rack", "name": "Rack", "branches": { "min": 1, "max": 1 } }
  ],
  "modulators": [
    { "kind": "macro", "name": "Macro", "params": [] }
  ]
}
